# --- Personal notes (addresses, logins, settings of one specific
#     installation). The repository is PUBLIC: these files stay
#     on the machine, and the documentation is written without them. ---
*.local.md

# --- Secrets ---
.env
*.env
!.env.example

# --- System ---
.DS_Store
*.swp

# --- Claude Code (local config) ---
.claude/settings.local.json

# --- Transit files (scans, extractions, trials). The repository is
#     PUBLIC, and this folder once held invoice pages: it stays
#     on the machine. ---
tmp/

# NOMIK
docker/data/
docker/logs/
