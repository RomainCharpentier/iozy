{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "web",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev",
        "--prefix",
        "iozycore/web"
      ],
      "port": 5173
    },
    {
      "name": "web-prod",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "preview",
        "--prefix",
        "iozycore/web"
      ],
      "port": 4173
    },
    {
      "name": "web-e2e",
      "runtimeExecutable": "cmd",
      "runtimeArgs": [
        "/c",
        "set IOZYCORE_API=http://localhost:8090&& npm run dev --prefix iozycore/web -- --port 5174 --strictPort"
      ],
      "port": 5174
    },
    {
      "name": "web-e2e-mac",
      "runtimeExecutable": "env",
      "runtimeArgs": [
        "IOZYCORE_API=http://localhost:8090",
        "npm",
        "run",
        "dev",
        "--prefix",
        "iozycore/web",
        "--",
        "--port",
        "5174",
        "--strictPort"
      ],
      "port": 5174
    },
    {
      "name": "iozyplay-server",
      "runtimeExecutable": "node",
      "runtimeArgs": [
        "iozyplay/server/index.js"
      ],
      "port": 3001
    },
    {
      "name": "iozyplay",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev",
        "--prefix",
        "iozyplay",
        "--",
        "--port",
        "5175",
        "--strictPort"
      ],
      "port": 5175
    }
  ]
}
