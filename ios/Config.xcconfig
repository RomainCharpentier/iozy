// Config.xcconfig — the ONE place to configure when you rename the app.
// Change the 2 values below, run `xcodegen generate`, and that is all:
// no Swift file and no other place in project.yml needs to change.

// Display name (iPhone icon, title in the app, system settings).
APP_NAME = IozyCore

// Technical identifier of the app (reverse-DNS, must stay unique).
// Recommended format: com.yourdomain.appname
APP_BUNDLE_ID = com.iozycore.app
