# Copy this file to ".env" (never committed) and fill in real values.

DB_NAME=iozycore
DB_USER=iozycore
DB_PASSWORD=change-me-please

# Email used by Let's Encrypt for certificate notifications
ACME_EMAIL=ton-email@example.com

# ─── Automatic update (docker-compose.nas.yml only) ──────────────────────
#
# The GitHub repository is PRIVATE, so the images published on GHCR are too:
# without credentials, watchtower queries the registry anonymously, is
# refused, and goes quiet - the app would stay on its version from six months
# ago without any error saying so.
#
# The token is a GitHub "personal access token" with READ-only access
# (scope `read:packages`, and nothing else: it never has to publish). The same
# one is used for the `docker login ghcr.io` done once by hand on the NAS.
GHCR_USER=ton-login-github
GHCR_TOKEN=ghp_xxx_lecture_seule

# BASIC_AUTH_USERS: REMOVED on 2026-08-30.
#
# The Synology deployment carried HTTP Basic authentication at the Traefik
# level. It was the safeguard of a time when the application had NO
# authentication of its own. It has had one since 2026-08-29
# (accounts, session, split by owner): this Basic had become
# a second password prompt in front of the first, and it broke the share
# links, whose recipient is supposed to have nothing to type.
#
# If you have a .env that still defines it, the variable is simply ignored.

# Invite code required to create an account AFTER the first one. The first
# account is free (someone has to get in) and takes over the collection
# already in the database. Left EMPTY, creation is closed once this first account
# exists: missing configuration closes the door, it does not open it.
IOZYCORE_INVITE_CODE=

# `true` as soon as there is TLS in front (any deployment): a `Secure` session
# cookie is never sent in clear text. Leave false locally, otherwise the browser
# refuses the cookie on http://localhost and nobody stays logged in.
SESSION_COOKIE_SECURE=false

# Origins allowed to make POST/PATCH/DELETE requests to the API
# (see backend/src/main/java/com/iozycore/api/config/CorsConfig.java).
# On Synology, replace with the real domain of the web service (e.g.
# https://app.iozycore.mondomaine.tld). CSV, no spaces.
WEB_ALLOWED_ORIGINS=https://app.iozycore.mondomaine.tld

# BGG application token - required since July 2025 for a compliant use
# of the BGG API (search, collection import, discovery).
# Full procedure: see IozyCore-GettingStarted.md, section
# "Obtenir et configurer un token BGG", or the README.md of this folder.
# Leaving it empty works for local testing, but does not follow the current
# BGG terms.
BGG_APPLICATION_TOKEN=

# Twitch Developer Console credentials - required for IGDB (video game
# metadata and discovery). Full procedure: see README.md,
# section "Obtenir et configurer des identifiants IGDB/Twitch".
# Unlike BGG, IGDB does not work at all without these credentials
# (no degraded mode) - leaving them empty only turns off these features,
# the rest of the app keeps working normally.
IGDB_CLIENT_ID=
IGDB_CLIENT_SECRET=

# MyAnimeList Client ID (official API v2) - completes Jikan for
# manga search, without replacing it. Full procedure: see
# README.md, section "Obtenir et configurer un Client ID MyAnimeList".
# Leaving it empty works (Jikan stays alone), but Jikan is a third-party
# wrapper that MyAnimeList blocks/throttles from time to time (504 outages
# "failed to connect to MyAnimeList") - this Client ID acts as a reliable relay
# at those moments, the official API not being affected by these blocks.
MAL_CLIENT_ID=

# Google Books API key (console.cloud.google.com, "Books API" enabled) -
# the anonymous quota (no key) is often used up in practice (429 "Quota
# exceeded"), shared worldwide between all unauthenticated uses.
# A key gives a quota dedicated to this project, much more reliable. Leaving it
# empty works (falls back to the shared anonymous quota), used for the ISBN scan
# (GoogleBooksBarcodeProvider), the French title search
# (GoogleBooksFrenchTitleProvider, itself a fallback behind Open Library)
# and the volume/edition search (GoogleBooksVolumeSearchProvider, 8
# requests per search - the biggest quota consumer).
GOOGLE_BOOKS_API_KEY=
# Optional, backup key(s) separated by commas (e.g. key2,key3) - a
# 2nd Google Cloud project with its own "Books API" key has its own independent
# daily quota, tried automatically as soon as the main key
# answers 429 (quota exceeded). Checked by hand: an intensive test
# session uses up the default quota of a single key quite fast.
GOOGLE_BOOKS_BACKUP_API_KEYS=

# Release calendar (batch 146): every night, the manga series that are ONGOING
# are re-read at the volume providers so that announced volumes
# show up in the calendar. `false` to never re-read (the calendar
# then only shows what the detail pages already looked up, and the dates
# entered by hand). The number of series re-read per night limits the
# Google Books quota used at night - 10 series is about 100
# requests, on a daily quota of 1000 per key.
RELEASES_REFRESH_ENABLED=true
RELEASES_REFRESH_SERIES_PER_NIGHT=10

# Missing covers of the manga volumes (batch 194): a little after each start,
# then every hour, the catalogue looks up the volume searches (BnF first,
# served from cache when fresh) and writes the cover of every volume that has
# none. `false` to leave it to the "Retrouver les jaquettes manquantes" button.
# Off by default when the release refresh is off. The number of series per
# run bounds the requests: one BnF request per series without covers.
COVERS_BACKFILL_ENABLED=true
COVERS_BACKFILL_SERIES_PER_RUN=25

# Google Gemini API key (aistudio.google.com/apikey - a real free tier,
# no bank card, unlike OpenAI). Used for Phase 2
# "AI-assisted purchase analysis": auto-filling of the edition sheets
# (number of volumes, publisher, new price) and market price estimate when
# no real observation exists. Leaving it empty turns off these
# two features entirely (adapter disables itself, like BGG/IGDB) - the
# rest of the purchase analysis keeps working without AI. The same key
# reads photos: those of a listing ("Envoyer mes photos") and those of
# the shelf (Catalogue > Importer depuis une photo); without a key, only the visible
# barcodes are read, locally.
GEMINI_API_KEY=
# Optional - Gemini model to use (default set in the code: gemini-3.5-flash,
# in the free tier as of 13/08/2026 - check ai.google.dev/pricing if that changes).
GEMINI_MODEL=
# Optional - the model that takes over when the main one stays saturated
# (503 after retries) or does not answer in time. Default in the code:
# gemini-3.5-flash-lite, the "lite" variant of the same generation, less
# in demand (seen on the evening of 16/09/2026: the main one no longer answered,
# the lite one answered in one second). Setting the same name as GEMINI_MODEL
# turns off the fallback. A 429 (quota) is never replayed elsewhere.
GEMINI_FALLBACK_MODEL=
