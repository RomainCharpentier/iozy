<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.3.4</version>
        <relativePath/>
    </parent>

    <groupId>com.iozycore</groupId>
    <artifactId>iozycore-backend</artifactId>
    <version>0.1.0-SNAPSHOT</version>
    <packaging>jar</packaging>

    <properties>
        <java.version>21</java.version>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>

        <!--
            Compilation : javac décide seul de ce qui est périmé.

            Le nom trompe. « incrementalCompilation » à true - le défaut de
            maven-compiler-plugin - ne veut pas dire « ne recompiler que ce qui
            a changé » : il veut dire « si QUELQUE CHOSE a changé, tout
            recompiler ». Et sa détection se trompe volontiers quand les
            sources vivent sur un montage lié (le cas ici : le projet est monté
            depuis Windows dans le conteneur Maven), si bien qu'elle conclut
            toujours au changement.

            Mesuré sur cette machine : `mvn -o test-compile` sans rien avoir
            modifié prenait 51 s, deux fois de suite. À false, javac fait la
            vraie comparaison fichier par fichier : 15 s, et 15 s à vide.
            Trente-six secondes rendues à CHAQUE invocation, tests compris.
        -->
        <maven.compiler.useIncrementalCompilation>false</maven.compiler.useIncrementalCompilation>
    </properties>

    <!--
        Note d'architecture (étape 10-11 de la conception) : seul le
        package com.iozycore.infrastructure dépend de Spring/JPA. Le
        domaine (com.iozycore.domain) et l'application
        (com.iozycore.application) restent des POJO purs à l'exception
        des annotations Spring légères (@Service) sur les services
        applicatifs, qui orchestrent mais ne contiennent aucune logique
        métier propre.
    -->
    <dependencies>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-jpa</artifactId>
        </dependency>
        <!--
            L'API n'était protégée par rien : n'importe qui l'atteignant
            pouvait tout lire et tout écrire. Acceptable tant qu'elle ne
            sortait pas de localhost, intenable dès qu'elle en sort (décision
            du 2026-08-29 : plusieurs personnes, chacune sa collection).
        -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-security</artifactId>
        </dependency>
        <dependency>
            <groupId>org.postgresql</groupId>
            <artifactId>postgresql</artifactId>
            <scope>runtime</scope>
        </dependency>
        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-core</artifactId>
        </dependency>
        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-database-postgresql</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springdoc</groupId>
            <artifactId>springdoc-openapi-starter-webmvc-ui</artifactId>
            <version>2.6.0</version>
        </dependency>

        <!--
            Lecture des codes-barres sur les photos, en local.

            `core` seul, délibérément : `zxing:javase` n'apporte qu'un
            LuminanceSource pour BufferedImage - une trentaine de lignes - au
            prix de deux dépendances transitives (jcommander, jai-imageio) dont
            ce projet n'a aucun usage. La conversion est écrite dans
            BarcodeImageDecoder.

            Aucun appel réseau, aucun modèle, aucun euro : un EAN se lit avec
            des règles, comme le texte d'une annonce. C'est ce qui permet à la
            reconnaissance de fonctionner même sans moteur de vision configuré.
        -->
        <dependency>
            <groupId>com.google.zxing</groupId>
            <artifactId>core</artifactId>
            <version>3.5.3</version>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework.security</groupId>
            <artifactId>spring-security-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>postgresql</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>org.testcontainers</groupId>
                <artifactId>testcontainers-bom</artifactId>
                <version>1.20.1</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
        </plugins>
    </build>
</project>
