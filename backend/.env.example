# Copier ce fichier en ".env" (jamais commité) et renseigner de vraies valeurs.

DB_NAME=iozycore
DB_USER=iozycore
DB_PASSWORD=change-me-please

# Email utilisé par Let's Encrypt pour les notifications de certificat
ACME_EMAIL=ton-email@example.com

# Token d'application BGG - requis depuis juillet 2025 pour un usage
# conforme de l'API BGG (recherche, import de collection, découverte).
# Marche à suivre complète : voir IozyCore-GettingStarted.md, section
# "Obtenir et configurer un token BGG", ou README.md de ce dossier.
# Laisser vide fonctionne pour tester en local, mais n'est pas conforme aux
# conditions actuelles de BGG.
BGG_APPLICATION_TOKEN=
