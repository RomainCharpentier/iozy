# Copier ce fichier en ".env" (jamais commité) et renseigner de vraies valeurs.

DB_NAME=iozycore
DB_USER=iozycore
DB_PASSWORD=change-me-please

# Email utilisé par Let's Encrypt pour les notifications de certificat
ACME_EMAIL=ton-email@example.com

# Origines autorisées à faire des requêtes POST/PATCH/DELETE vers l'API
# (voir backend/src/main/java/com/iozycore/api/config/CorsConfig.java).
# En Synology, remplacer par le vrai domaine du service web (ex:
# https://app.iozycore.mondomaine.tld). CSV, sans espace.
WEB_ALLOWED_ORIGINS=https://app.iozycore.mondomaine.tld

# Token d'application BGG - requis depuis juillet 2025 pour un usage
# conforme de l'API BGG (recherche, import de collection, découverte).
# Marche à suivre complète : voir IozyCore-GettingStarted.md, section
# "Obtenir et configurer un token BGG", ou README.md de ce dossier.
# Laisser vide fonctionne pour tester en local, mais n'est pas conforme aux
# conditions actuelles de BGG.
BGG_APPLICATION_TOKEN=

# Identifiants Twitch Developer Console - requis pour IGDB (métadonnées et
# découverte jeux vidéo). Marche à suivre complète : voir README.md,
# section "Obtenir et configurer des identifiants IGDB/Twitch".
# Contrairement à BGG, IGDB ne fonctionne pas du tout sans ces identifiants
# (pas de mode dégradé) - laisser vide désactive juste ces fonctionnalités,
# le reste de l'app continue de marcher normalement.
IGDB_CLIENT_ID=
IGDB_CLIENT_SECRET=

# Client ID MyAnimeList (API officielle v2) - complète Jikan pour la
# recherche manga, sans le remplacer. Marche à suivre complète : voir
# README.md, section "Obtenir et configurer un Client ID MyAnimeList".
# Laisser vide fonctionne (Jikan reste seul), mais Jikan est un wrapper
# tiers que MyAnimeList bloque/throttle par intermittence (pannes 504
# "failed to connect to MyAnimeList") - ce Client ID sert de relais fiable
# ces moments-là, l'API officielle n'étant pas concernée par ces blocages.
MAL_CLIENT_ID=

# Clé API Google Books (console.cloud.google.com, API "Books API" activée) -
# quota anonyme (sans clé) fréquemment épuisé en pratique (429 "Quota
# exceeded"), partagé mondialement entre tous les usages non authentifiés.
# Une clé donne un quota dédié à ce projet, bien plus fiable. Laisser vide
# fonctionne (repli sur le quota anonyme partagé), utilisé pour le scan ISBN
# (GoogleBooksBarcodeProvider) et la recherche de titre français
# (GoogleBooksFrenchTitleProvider, elle-même en repli derrière Open Library).
GOOGLE_BOOKS_API_KEY=
