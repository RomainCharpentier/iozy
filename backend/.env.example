# Copier ce fichier en ".env" (jamais commité) et renseigner de vraies valeurs.

DB_NAME=iozycore
DB_USER=iozycore
DB_PASSWORD=change-me-please

# Email utilisé par Let's Encrypt pour les notifications de certificat
ACME_EMAIL=ton-email@example.com

# ─── Mise à jour automatique (docker-compose.nas.yml uniquement) ─────────
#
# Le dépôt GitHub est PRIVÉ, donc les images publiées sur GHCR le sont aussi :
# sans identifiants, watchtower interroge le registre en anonyme, se fait
# refuser, et se tait - l'app resterait sur sa version d'il y a six mois sans
# qu'aucune erreur ne le dise.
#
# Le jeton est un « personal access token » GitHub en LECTURE seule
# (portée `read:packages`, et rien d'autre : il n'a jamais à publier). Le même
# sert au `docker login ghcr.io` fait une fois à la main sur le NAS.
GHCR_USER=ton-login-github
GHCR_TOKEN=ghp_xxx_lecture_seule

# BASIC_AUTH_USERS : RETIRÉ le 2026-08-30.
#
# Le déploiement Synology portait une authentification HTTP Basic au niveau
# de Traefik. C'était le garde-fou d'une époque où l'application n'avait
# AUCUNE authentification en propre. Elle en a une depuis le 2026-08-29
# (comptes, session, cloisonnement par propriétaire) : ce Basic était devenu
# une seconde demande de mot de passe devant la première, et il cassait les
# liens de partage, dont le destinataire est censé n'avoir rien à saisir.
#
# Si tu as un .env qui le définit encore, la variable est simplement ignorée.

# Code d'invitation exigé pour créer un compte APRÈS le premier. Le premier
# compte est libre (il faut bien que quelqu'un entre) et reprend la collection
# déjà en base. Laissé VIDE, la création est fermée une fois ce premier compte
# créé : l'absence de configuration ferme la porte, elle ne l'ouvre pas.
IOZYCORE_INVITE_CODE=

# `true` dès qu'il y a du TLS devant (tout déploiement) : un cookie de session
# `Secure` ne part jamais en clair. Laisser faux en local, sinon le navigateur
# refuse le cookie sur http://localhost et personne ne reste connecté.
SESSION_COOKIE_SECURE=false

# Origines autorisées à faire des requêtes POST/PATCH/DELETE vers l'API
# (voir backend/src/main/java/com/iozycore/api/config/CorsConfig.java).
# En Synology, remplacer par le vrai domaine du service web (ex:
# https://app.iozycore.mondomaine.tld). CSV, sans espace.
WEB_ALLOWED_ORIGINS=https://app.iozycore.mondomaine.tld

# Token d'application BGG - requis depuis juillet 2025 pour un usage
# conforme de l'API BGG (recherche, import de collection, découverte).
# Marche à suivre complète : voir IozyCore-GettingStarted.md, section
# "Obtenir et configurer un token BGG", ou README.md de ce dossier.
# Laisser vide fonctionne pour tester en local, mais n'est pas conforme aux
# conditions actuelles de BGG.
BGG_APPLICATION_TOKEN=

# Identifiants Twitch Developer Console - requis pour IGDB (métadonnées et
# découverte jeux vidéo). Marche à suivre complète : voir README.md,
# section "Obtenir et configurer des identifiants IGDB/Twitch".
# Contrairement à BGG, IGDB ne fonctionne pas du tout sans ces identifiants
# (pas de mode dégradé) - laisser vide désactive juste ces fonctionnalités,
# le reste de l'app continue de marcher normalement.
IGDB_CLIENT_ID=
IGDB_CLIENT_SECRET=

# Client ID MyAnimeList (API officielle v2) - complète Jikan pour la
# recherche manga, sans le remplacer. Marche à suivre complète : voir
# README.md, section "Obtenir et configurer un Client ID MyAnimeList".
# Laisser vide fonctionne (Jikan reste seul), mais Jikan est un wrapper
# tiers que MyAnimeList bloque/throttle par intermittence (pannes 504
# "failed to connect to MyAnimeList") - ce Client ID sert de relais fiable
# ces moments-là, l'API officielle n'étant pas concernée par ces blocages.
MAL_CLIENT_ID=

# Clé API Google Books (console.cloud.google.com, API "Books API" activée) -
# quota anonyme (sans clé) fréquemment épuisé en pratique (429 "Quota
# exceeded"), partagé mondialement entre tous les usages non authentifiés.
# Une clé donne un quota dédié à ce projet, bien plus fiable. Laisser vide
# fonctionne (repli sur le quota anonyme partagé), utilisé pour le scan ISBN
# (GoogleBooksBarcodeProvider), la recherche de titre français
# (GoogleBooksFrenchTitleProvider, elle-même en repli derrière Open Library)
# et la recherche de tomes/éditions (GoogleBooksVolumeSearchProvider, 8
# requêtes par recherche - le plus gros consommateur de quota).
GOOGLE_BOOKS_API_KEY=
# Optionnel, clé(s) de secours séparées par des virgules (ex: cle2,cle3) - un
# 2e projet Google Cloud avec sa propre clé "Books API" a son propre quota
# journalier indépendant, essayé automatiquement dès que la clé principale
# répond 429 (quota dépassé). Vérifié manuellement : une session de tests
# intensifs épuise le quota par défaut d'une seule clé assez vite.
GOOGLE_BOOKS_BACKUP_API_KEYS=

# Clé API Google Gemini (aistudio.google.com/apikey - palier gratuit réel,
# sans carte bancaire, contrairement à OpenAI). Utilisée pour la Phase 2
# "Analyse d'achat assistée par IA" : auto-remplissage des fiches d'édition
# (nb de tomes, éditeur, prix neuf) et estimation de prix de marché quand
# aucune observation réelle n'existe. Laisser vide désactive entièrement ces
# deux fonctionnalités (adaptateur auto-désactivé, comme BGG/IGDB) - le
# reste de l'analyse d'achat continue de fonctionner sans IA.
GEMINI_API_KEY=
# Optionnel - modèle Gemini à utiliser (défaut géré côté code : gemini-3.5-flash,
# dans le palier gratuit au 13/08/2026 - vérifier ai.google.dev/pricing si ça change).
GEMINI_MODEL=
